{
  "expo": {
    "name": "konutHub",
    "slug": "konuthub",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sahinmaral.konuthub",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.sahinmaral.konuthub",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "konutHub profil fotoğrafınızı güncellemek için galerinize erişmek istiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#ffffff"
        }
      ],
      "@sentry/react-native",
      "@react-native-firebase/app",
      "@react-native-google-signin/google-signin",
      [
        "react-native-fbsdk-next",
        {
          "displayName": "KonutHub"
        }
      ],
      "@react-native-firebase/auth"
    ],
    "extra": {
      "eas": {
        "projectId": "78b7f5a0-e965-4a6e-8b74-e728a189c499"
      }
    },
    "owner": "sahinmaral"
  }
}
